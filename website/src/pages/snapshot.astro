---
// The public Growth Snapshot surface. STRUCTURE ONLY in this phase.
//
// COPY STATUS — mostly placeholder wording to prove the structure, EXCEPT the
// intro lede and the boundary line beneath it, which carry Council-ratified
// wording from the public product-language conformity pass.
//
//   The Snapshot may state what is observably true.
//   Only the Growth Report may state what matters most.
//
// This page must never claim to identify, rank or prioritise a constraint.
//
// KNOWN GAP — NOW CLOSED. This page previously carried a note saying the
// backend still returned `primaryConstraint`, so the result blockquote could
// render a prioritised claim regardless of the copy around it. Product Council
// approved Option A and the backend now sends a PublicSnapshot: observations,
// strengths, open questions, evidence confidence and a receipt. There is no
// constraint field in the payload to render, so the boundary no longer depends
// on this file's wording.
//
// Every state the run can end in has a real container here, present in the
// served HTML and revealed by the client script. Nothing is injected as a
// string of markup at runtime, so the page's structure is auditable by reading
// the source rather than by watching it run.
//
// Product boundary, enforced by construction: this page RENDERS what the
// backend returns. It does not compute, rank, re-word or second-guess a
// constraint. The judgement lives in the Growth Report.
import BaseLayout from "../layouts/BaseLayout.astro";
import { ROUTES, STRATEGY_CALL_URL, SNAPSHOT_API_ORIGIN } from "../lib/config";

// Read at BUILD time. Two jobs: a missing or invalid API origin fails the build
// rather than shipping a page whose primary action silently does nothing, and
// the resolved origin warms the connection before the visitor submits.
const apiOrigin = SNAPSHOT_API_ORIGIN;
---

<link rel="preconnect" href={apiOrigin} crossorigin slot="head" />

<BaseLayout
  title="Growth Snapshot — DR Digital Systems"
  description="Enter a business website and receive a Growth Snapshot: a short, specific read of what is publicly observable — where the evidence is clear, and where it isn't."
>
  <section class="intro">
    <div class="wrap stack">
      <p class="kicker">Growth Snapshot</p>
      <h1>See what your public evidence says about your growth</h1>
      <p class="lede prose">
        Enter your business website. We read what is publicly observable and show where the evidence is
        clear, where it is not, and what needs human judgement to settle.
      </p>
      <!-- The boundary, stated before the visitor runs it rather than only after
           a result appears. The Growth Report handoff below the result says the
           same thing, but that block is hidden until a run completes. -->
      <p class="prose muted">
        The Snapshot does not diagnose your main constraint or prescribe the order of work.
      </p>

      <!-- INPUT + SUBMIT.
           A real <form> with a real submit button, so the control is keyboard-
           operable and announced correctly before any script runs. -->
      <form id="snapshot-form" class="snapshot-form" novalidate>
        <div class="snapshot-form__field">
          <label for="business-url">Your business website</label>
          <input
            id="business-url"
            name="url"
            type="text"
            inputmode="url"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder="yourbusiness.co.za"
            aria-describedby="url-hint"
            required
          />
          <p id="url-hint" class="field-hint">
            Free. Based on publicly observable evidence only — nothing private is accessed.
          </p>
        </div>
        <button id="snapshot-submit" class="button button--primary" type="submit">
          Run my Growth Snapshot
        </button>
      </form>

      <noscript>
        <div class="notice" data-tone="info">
          <p>
            The Growth Snapshot runs in your browser and needs JavaScript enabled. If you would rather
            not enable it, <a href={STRATEGY_CALL_URL}>book a Strategy Call</a> and we will go through
            this with you directly.
          </p>
        </div>
      </noscript>
    </div>
  </section>

  <div class="wrap">
    <!-- WAITING STATE.
         Milestones are appended only as the backend reports a stage genuinely
         starting. There is no percentage, no progress bar and no predicted
         finish time, because none of those would be true. -->
    <section id="state-waiting" class="state" hidden aria-labelledby="waiting-heading">
      <div class="stack">
        <h2 id="waiting-heading" class="state__heading">Reading your public evidence</h2>
        <p class="muted">This usually takes a minute or two. You can leave this tab open.</p>
        <!-- Each milestone is announced as it genuinely occurs, so a screen
             reader user knows work is progressing without watching the page. -->
        <ul id="milestones" class="milestones" aria-live="polite" aria-atomic="false"></ul>
        <!-- Stage 1.2. Shown only if the connection drops and we go looking for
             the completed run. It must never read as a new analysis: the
             Snapshot was computed once and we are collecting it, not redoing
             it. No percentage, no countdown, no invented progress. -->
        <p id="recovery-note" class="notice" data-tone="info" role="status" hidden></p>
      </div>
    </section>

    <!-- FAILURE STATE. Copy comes from src/lib/snapshot-states.ts, never from
         raw backend text. -->
    <section id="state-failure" class="state" hidden aria-labelledby="failure-heading">
      <div class="stack">
        <h2 id="failure-heading" class="state__heading">We couldn't complete this</h2>
        <!-- role="status" so a failure is announced, not silently swapped in. -->
        <div class="notice" data-tone="warn" role="status" aria-live="polite">
          <p id="failure-message"></p>
        </div>
        <p id="failure-human-path" hidden>
          In the meantime you can <a href={STRATEGY_CALL_URL}>book a Strategy Call</a> and we will go
          through this with you directly.
        </p>
        <button id="failure-retry" class="button button--secondary" type="button">Try again</button>
      </div>
    </section>

    <!-- RESULT STATE. The approved observation architecture, in order:
         what we can see · why we think this · what is working ·
         what we could not settle · confidence · evidence receipt.

         "Why we think this" is not a separate finding — it is the counted
         proof behind each observation above it, rendered as the receipt for
         that specific line. Every list container exists in the served HTML and
         is filled by the script; nothing is injected as markup. -->
    <section id="state-result" class="state" hidden aria-labelledby="result-heading">
      <article class="panel stack">
        <p class="kicker">Growth Snapshot</p>
        <!-- tabindex="-1" so focus can be moved here when the result arrives:
             the visitor is taken to the result rather than left at the form. -->
        <h2 id="result-heading" class="result__business" tabindex="-1"></h2>
        <p id="result-prepared" class="muted"></p>

        <p id="result-mock" class="notice" data-tone="warn" hidden>
          Mock output — structural testing only, not a real analysis of this business.
        </p>

        <blockquote class="result__read">
          <p id="result-business-read"></p>
        </blockquote>

        <div class="result__section">
          <h3>What we can see</h3>
          <ul id="result-signals" class="findings"></ul>
        </div>
        <div class="result__section">
          <h3>What is working</h3>
          <ul id="result-strengths" class="findings"></ul>
        </div>
        <div class="result__section">
          <h3>What we could not settle</h3>
          <ul id="result-unsettled" class="findings"></ul>
        </div>
        <div class="result__section">
          <h3>Confidence</h3>
          <p id="result-confidence" class="result__confidence"></p>
        </div>
        <div class="result__section">
          <h3>Evidence receipt</h3>
          <p id="result-receipt-summary"></p>
          <ul id="result-pages" class="receipt"></ul>
          <ul id="result-limitations" class="receipt receipt--muted"></ul>
        </div>

        <p id="result-boundary" class="result__boundary"></p>
      </article>

      <!-- GROWTH REPORT CTA — placed after the result, where the visitor has
           just seen observable evidence and the natural next question is what it
           means. One primary action, not a menu. -->
      <aside class="handoff">
        <h3>This is observation. The Growth Report is diagnosis.</h3>
        <p class="prose">
          A Growth Snapshot states what can be observed. A Growth Report decides what is actually
          limiting your growth, what is connected to it, and the order to address it in.
        </p>
        <a
          class="button button--primary"
          href={ROUTES.start}
          id="report-cta"
          data-analytics="report_cta_clicked"
        >
          Start a Growth Report
        </a>
      </aside>
    </section>
  </div>

  <!--
    THE ONE JAVASCRIPT ISLAND ON THIS SITE.

    Why it earns its place: the Snapshot is a 1-2 minute streamed job. Without
    client JS the visitor would either stare at a blocked page load or the site
    would need a server runtime to proxy the stream — and the approved
    architecture is static-first with no SSR and no reverse proxy at launch.
    This script is the smallest thing that satisfies that.

    What it deliberately is NOT: a framework, a router, a state library, or a
    hydration boundary. It is a form handler. The page is fully rendered HTML
    before it runs, and every state container already exists in the document.
  -->
  <script>
    import { runSnapshot, recoverRun } from "../lib/snapshot-client";
    import {
      durationBucket,
      track,
      SNAPSHOT_STARTED,
      SNAPSHOT_COMPLETED,
      SNAPSHOT_FAILED,
      REPORT_CTA_CLICKED,
    } from "../lib/analytics-events";

    const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

    const form = $<HTMLFormElement>("snapshot-form");
    const input = $<HTMLInputElement>("business-url");
    const submit = $<HTMLButtonElement>("snapshot-submit");
    const waiting = $<HTMLElement>("state-waiting");
    const failure = $<HTMLElement>("state-failure");
    const result = $<HTMLElement>("state-result");
    const milestones = $<HTMLUListElement>("milestones");

    const show = (section: HTMLElement | null): void => {
      for (const el of [waiting, failure, result]) el.hidden = el !== section;
    };

    const setText = (id: string, value: string | undefined): void => {
      // textContent, never innerHTML: backend output is data, not markup.
      $(id).textContent = value ?? "";
    };

    // Copy for a list that came back empty. Kept here rather than injected from
    // the backend so an absent section still reads as a considered outcome.
    const EMPTY = {
      signals: "Nothing we looked at settled cleanly enough on this site for us to state it here.",
      strengths:
        "Nothing we looked at settled cleanly enough for us to point to it as a strength. That is a limit of what we could read, not a verdict on your business.",
      unsettled: "Everything we looked at reached a conclusion in this run.",
    };

    interface Signal {
      statement: string;
      proof: string;
      source: string;
    }
    interface Unsettled {
      question: string;
      reason: string;
    }

    /** One observation, with its proof beneath it. The proof line IS the
     *  "why we think this" for that specific statement — kept attached to the
     *  claim rather than collected into a separate section, so a reader can
     *  never mistake which receipt belongs to which line. */
    function renderFindings(id: string, items: Signal[] | undefined, empty: string): void {
      const list = $<HTMLUListElement>(id);
      list.replaceChildren();
      if (!items?.length) {
        const li = document.createElement("li");
        li.className = "findings__empty";
        li.textContent = empty;
        list.append(li);
        return;
      }
      for (const item of items) {
        const li = document.createElement("li");
        const statement = document.createElement("p");
        statement.className = "findings__statement";
        statement.textContent = item.statement;
        const proof = document.createElement("p");
        proof.className = "findings__proof";
        proof.textContent = item.proof;
        li.append(statement, proof);
        list.append(li);
      }
    }

    function renderUnsettled(id: string, items: Unsettled[] | undefined, empty: string): void {
      renderFindings(
        id,
        items?.map((u) => ({ statement: `We could not settle ${u.question}.`, proof: u.reason, source: "" })),
        empty
      );
    }

    function renderLines(id: string, values: string[]): void {
      const list = $<HTMLUListElement>(id);
      list.replaceChildren();
      for (const value of values) {
        const li = document.createElement("li");
        li.textContent = value;
        list.append(li);
      }
    }

    function renderFailure(message: string, offerHumanPath: boolean): void {
      setText("failure-message", message);
      $("failure-human-path").hidden = !offerHumanPath;
      show(failure);
      $<HTMLButtonElement>("failure-retry").focus();
    }

    let running = false;

    // ── Stage 1.2: bounded recovery context ─────────────────────────────────
    //
    // A refresh or an accidental back-navigation mid-run should not throw away
    // the only handle on a Snapshot that has already been paid for. Only the
    // run id and a timestamp are kept — never the Snapshot itself, never the
    // submitted URL, never anything about the visitor.
    //
    // sessionStorage, not localStorage: it survives reload and navigation
    // within the tab, which is the case we are protecting, and disappears when
    // the tab closes, which is the right lifetime for a handle to one run. A
    // run is unrecoverable long before a new tab would ever want it, so
    // localStorage would only lengthen how long we store something useless.
    // Every access is wrapped — storage throws outright in some privacy modes.
    const PENDING_KEY = "drds.pendingRunId";
    const PENDING_MAX_AGE_MS = 30 * 60 * 1000;

    function rememberRun(id: string): void {
      try {
        sessionStorage.setItem(PENDING_KEY, JSON.stringify({ runId: id, at: Date.now() }));
      } catch {
        /* storage unavailable — recovery still works within this page view */
      }
    }

    function forgetRun(): void {
      try {
        sessionStorage.removeItem(PENDING_KEY);
      } catch {
        /* nothing to clean up */
      }
    }

    function recallRun(): string | null {
      try {
        const raw = sessionStorage.getItem(PENDING_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as { runId?: unknown; at?: unknown };
        if (typeof parsed.runId !== "string" || typeof parsed.at !== "number") return null;
        if (Date.now() - parsed.at > PENDING_MAX_AGE_MS) {
          forgetRun();
          return null;
        }
        return parsed.runId;
      } catch {
        return null;
      }
    }

    function showRecovering(attempt: number, attempts: number): void {
      const note = $("recovery-note");
      note.textContent =
        `The connection was interrupted. Checking for your completed Growth Snapshot ` +
        `(${attempt} of ${attempts})…`;
      note.hidden = false;
      show(waiting);
    }

    // One set of handlers, used by a live run and by a recovery attempt alike —
    // so a recovered Snapshot renders through exactly the same code path as a
    // streamed one, and cannot drift from it.
    const handlers = {
      onMilestone(label: string) {
        const item = document.createElement("li");
        item.textContent = label;
        milestones.append(item);
      },
      onRunId(id: string) {
        rememberRun(id);
      },
      onRecovering(attempt: number, attempts: number) {
        showRecovering(attempt, attempts);
      },
      onResult(payload: Parameters<typeof renderResult>[0]) {
        forgetRun();
        renderResult(payload);
      },
      onFailure(f: { message: string; offerHumanPath: boolean; state: string }) {
        forgetRun();
        $("recovery-note").hidden = true;
        renderFailure(f.message, f.offerHumanPath);
        track(SNAPSHOT_FAILED, { state: f.state });
      },
    };

    let startedAt = 0;

    // Renders a completed Snapshot. Deliberately shared: a Snapshot that
    // arrived over the live stream and one collected afterwards by recovery are
    // the same product and must render through the same code.
    function renderResult(payload: {
      businessName?: string;
      mockMode?: boolean;
      snapshot: {
        businessRead: string;
        whatWeCanSee: Signal[];
        whatIsWorking: Signal[];
        whatWeCouldNotSettle: Unsettled[];
        evidenceConfidence: string;
        evidenceReceipt?: {
          pagesInspected?: string[];
          pagesInspectedCount?: number;
          signalsChecked?: number;
          signalsSettled?: number;
          limitations?: string[];
        };
        boundaryNote: string;
      };
    }): void {
      const s = payload.snapshot;
      $("recovery-note").hidden = true;
      setText("result-heading", payload.businessName || "Your business");
      setText(
        "result-prepared",
        `Prepared ${new Date().toLocaleDateString("en-ZA", {
          day: "numeric",
          month: "long",
          year: "numeric",
        })} · based on publicly observable evidence`
      );
      $("result-mock").hidden = payload.mockMode !== true;
      setText("result-business-read", s.businessRead);

      renderFindings("result-signals", s.whatWeCanSee, EMPTY.signals);
      renderFindings("result-strengths", s.whatIsWorking, EMPTY.strengths);
      renderUnsettled("result-unsettled", s.whatWeCouldNotSettle, EMPTY.unsettled);

      setText("result-confidence", s.evidenceConfidence);

      const r = s.evidenceReceipt;
      const pages = r?.pagesInspectedCount ?? 0;
      setText(
        "result-receipt-summary",
        pages
          ? `We read ${pages} of your published page${pages === 1 ? "" : "s"} and looked at ` +
              `${r?.signalsChecked} thing${r?.signalsChecked === 1 ? "" : "s"}, of which ${r?.signalsSettled} settled.`
          : "No published page could be read on this run."
      );
      renderLines("result-pages", r?.pagesInspected ?? []);
      renderLines("result-limitations", r?.limitations ?? []);

      setText("result-boundary", s.boundaryNote);
      show(result);
      $("result-heading").focus();
      // No property derived from the result's content: the event records that a
      // run finished and roughly how long it took, nothing about what was found
      // or about the business it was found on.
      track(SNAPSHOT_COMPLETED, {
        durationBucket: durationBucket(performance.now() - startedAt),
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (running) return;

      const url = input.value.trim();
      if (!url) {
        renderFailure("Please enter your business website address.", false);
        input.focus();
        return;
      }

      running = true;
      submit.disabled = true;
      form.setAttribute("aria-busy", "true");
      milestones.replaceChildren();
      $("recovery-note").hidden = true;
      show(waiting);
      // No business URL is ever sent as an analytics property.
      track(SNAPSHOT_STARTED, { entry: "snapshot_page" });
      startedAt = performance.now();

      // The ONLY call to /api/snapshot on this page, and it happens only here —
      // behind a real submit, from a real click. Nothing in the recovery path
      // can reach it, so a delivery failure can never start a second paid run.
      await runSnapshot(url, handlers);

      running = false;
      submit.disabled = false;
      form.removeAttribute("aria-busy");
    });

    // A run was in flight when this page was last loaded — a refresh, a back
    // navigation, an accidental reload. Collect it rather than losing it. This
    // calls recovery only; it never starts an analysis, so a reload can never
    // cost anything.
    const pending = recallRun();
    if (pending) {
      running = true;
      submit.disabled = true;
      milestones.replaceChildren();
      showRecovering(1, 7);
      startedAt = performance.now();
      void recoverRun(pending, handlers).finally(() => {
        running = false;
        submit.disabled = false;
      });
    }

    $("failure-retry").addEventListener("click", () => {
      show(null);
      input.focus();
    });

    $("report-cta").addEventListener("click", () => {
      track(REPORT_CTA_CLICKED, { from: "snapshot_result" });
    });
  </script>
</BaseLayout>

<style>
  .intro {
    padding-block: clamp(2.5rem, 7vw, 4rem) 0;
  }

  .snapshot-form {
    display: grid;
    gap: 1rem;
    align-items: end;
    max-width: 34rem;
    margin-block-start: 1rem;
  }

  @media (min-width: 34rem) {
    .snapshot-form {
      grid-template-columns: 1fr auto;
    }
    .snapshot-form__field {
      grid-column: 1 / -1;
    }
    .snapshot-form button {
      grid-column: 1;
      justify-self: start;
    }
  }

  .snapshot-form__field {
    display: grid;
    gap: 0.4rem;
  }

  .state {
    padding-block: var(--section-gap) 0;
  }

  .state__heading {
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
  }

  .milestones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .milestones li {
    color: var(--ink-2);
    font-size: 0.94rem;
    padding-inline-start: 1.4rem;
    position: relative;
  }

  .milestones li::before {
    content: "✓";
    position: absolute;
    inset-inline-start: 0;
    color: var(--gold);
  }

  .result__business {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
  }

  /* The business read: identity, not a finding. It keeps the gold rule the
     constraint blockquote used to carry, because the position in the page is
     the same — what changed is that the sentence no longer makes a claim. */
  .result__read {
    margin: 0;
    padding-block: 1.25rem;
    border-top: 1px solid var(--gold-fill);
    border-bottom: 1px solid var(--rule);
  }

  .result__read p {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.45;
    margin: 0;
  }

  .result__section {
    display: grid;
    gap: 0.35rem;
  }

  .findings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .findings li {
    display: grid;
    gap: 0.2rem;
  }

  .findings__statement {
    margin: 0;
  }

  /* The receipt for the statement above it. Quieter on purpose: it is there to
     be checked, not to read as a second finding. */
  .findings__proof {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--slate);
  }

  .findings__empty {
    color: var(--slate);
  }

  .receipt {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--slate);
    overflow-wrap: anywhere;
  }

  .receipt--muted {
    margin-block-start: 0.75rem;
    color: var(--ink-2);
    opacity: 0.75;
  }

  .result__confidence {
    font-style: italic;
    color: var(--slate);
    font-size: 0.9rem;
    margin: 0;
  }

  /* The product boundary, carried in the payload and restated at the end of the
     result rather than only in the page copy above the form. */
  .result__boundary {
    margin: 0;
    padding-block-start: 1rem;
    border-top: 1px solid var(--rule);
    font-size: 0.88rem;
    color: var(--slate);
  }

  .handoff {
    margin-block-start: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--surface-2);
    border-radius: var(--radius);
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
</style>
