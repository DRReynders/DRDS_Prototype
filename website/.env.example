# DRDS Website V2 — build-time configuration.
#
# Copy to `.env` and set the value for the environment you are building for.
# NOTHING IN THIS FILE IS A SECRET, and nothing secret may ever be added to it.
# Astro inlines every `PUBLIC_`-prefixed value into the built JavaScript, so any
# value here is visible to every visitor. Keys, tokens and credentials belong in
# the Snapshot backend's own environment, never here.

# Origin of the Growth Snapshot API. No trailing slash.
#
# The website talks to the Snapshot service over the public internet; it is not
# proxied and not co-deployed. Pointing this at a different origin is how a
# staging site talks to a staging backend.
#
#   production : https://drdsprototype-production.up.railway.app
#   local      : http://localhost:3000
#
# Required for `npm run build`. `npm run dev` falls back to localhost:3000 with a
# warning, so a developer can work against a locally running backend without
# creating this file first.
PUBLIC_SNAPSHOT_API_ORIGIN=https://drdsprototype-production.up.railway.app
