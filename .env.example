# Copy this file to `.env` (same folder) and fill in the real values.
# `.env` is gitignored and must never be committed.

# Which LLM provider the pipeline uses. Supported values:
#   anthropic  (default) — real reasoning; requires ANTHROPIC_API_KEY below
#   mock                  — structural testing only; every output is marked [MOCK],
#                           zero tokens / zero cost. Explicit opt-in only.
DRDS_LLM_PROVIDER=anthropic

# Required when DRDS_LLM_PROVIDER=anthropic. Add your real key locally before
# running the full pipeline (Contracts 1, 2, 4 and 5 make real LLM calls).
ANTHROPIC_API_KEY=

# --- Task-level model routing (configuration, never hardcoded in Contracts) ---
# "fast" tier — simple extraction/classification (CIP identification, evidence
# text checks). Default: claude-haiku-4-5-20251001
DRDS_MODEL_FAST=
# "reasoning" tier — Goal Model inference, CDER reasoning, Snapshot copywriting.
# Default: claude-sonnet-5
DRDS_MODEL_REASONING=
# Optional single override: if set, BOTH tiers use this model (wins over the two above).
DRDS_MODEL=

# --- Budget guards (soft limits) ---
# Maximum estimated spend per run, in USD. Checked before each LLM call; when
# reached, the run stops gracefully with a clear message. Empty or 0 = no limit.
# A typical full run makes 4-8 calls; 0.50 is a generous first ceiling.
MAX_RUN_COST_USD=0.50
# Maximum estimated spend per calendar day across all runs (public protection).
# When reached, new visitors see an honest "at capacity today" message.
#
# REQUIRED, and must be a positive finite number. There is no uncapped mode.
# This guard fails CLOSED: if the value is absent, blank, malformed, zero,
# negative or non-finite — or if today's spend ledger in `runs/` exists but
# cannot be read or parsed — the web layer refuses every Growth Snapshot request
# before any model call is made, and says so in the startup log
# (PV_GUARD_CONFIG). There is no silent fallback to unlimited spend.
#
# What this control is, honestly: a SOFT, BEST-EFFORT, PER-CONTAINER daily
# application budget. It is checked before a run starts, so a run already in
# flight can overshoot by roughly one run's cost; the ledger is a flat file in
# `runs/`, so a Railway redeploy starts a fresh ledger and a fresh day's
# allowance. It is not a hard cap and not global across instances.
MAX_DAILY_COST_USD=5.00

# --- Public exposure guards ---
# Growth Snapshot runs allowed per IP per hour. 0 disables the limit.
# An unparseable value falls back to the default of 4 rather than disabling
# the limit — only an explicit 0 switches it off.
RATE_LIMIT_RUNS_PER_HOUR=4

# --- Browser origin boundary (CORS) ---
# Comma-separated list of EXACT website origins permitted to call the API from a
# browser. Not a secret. No wildcard: `*` is rejected, not honoured.
#
# Only browser requests are affected. A request with no Origin header — CLI use,
# direct API inspection, engineering tooling — is unchanged and needs no entry
# here. An unset or unusable value therefore means "no browser origin is
# allowed", which fails closed rather than opening the API.
#
# Entries are normalised to their origin, so a trailing slash or a path makes no
# difference: https://example.com/ and https://example.com/x both mean
# https://example.com.
#
#   local Astro dev : http://localhost:4321
#   production      : https://drdigitalsystems.co.za
SNAPSHOT_ALLOWED_ORIGINS=http://localhost:4321

# --- Transactional email (Resend) ---
# Required for the follow-up email. Without it, the Snapshot still displays and
# the email form reports honestly that sending is not configured.
RESEND_API_KEY=
# Verified sender. The domain must be verified in Resend (DNS records) first.
EMAIL_FROM=DRDS Growth Snapshot <snapshot@drdigitalsystems.co.za>

# --- Growth Report enquiry (POST /api/report-enquiry) ---
# Where a submitted Growth Report enquiry is emailed. INTERNAL recipient — this
# is DRDS's own address, never the enquirer's.
#
# REQUIRED for the enquiry form to work, and it has NO DEFAULT. There is no
# database and no lead store, so this email is the entire record of a
# submission: if this is unset the route refuses to send and answers 503 rather
# than falling back to the Snapshot sender or any other address that happens to
# be configured. Delivery uses the same Resend credentials as above.
DRDS_REPORT_ENQUIRY_TO=audit@drdigitalsystems.co.za

# --- Web server ---
PORT=3000
